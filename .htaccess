# Vale para conhecerescola.com.br, www, tecnico. e graduacao.
# (os subdomínios usam as subpastas tecnico/ e graduacao/ como raiz, então herdam este arquivo)

Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# Arquivos internos do repositório não são públicos
RewriteRule (^|/)(_interno|\.claude|\.git)(/|$) - [F,L]
RewriteRule \.md$ - [F,L]
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule (^|/)(package(-lock)?\.json|build\.mjs|node_modules)(/|$) - [F,L]

# Validação do SSL (AutoSSL) fica fora dos redirecionamentos
RewriteCond %{REQUEST_URI} ^/\.well-known/
RewriteRule ^ - [L]

# www -> domínio sem www (já em https)
RewriteCond %{HTTP_HOST} ^www\.conhecerescola\.com\.br$ [NC]
RewriteRule ^ https://conhecerescola.com.br%{REQUEST_URI} [R=301,L]

# http -> https
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Endereços do WordPress antigo (apareciam como 404 no Search Console)
# -> página nova equivalente, para não perder a autoridade dos links antigos
RewriteCond %{HTTP_HOST} ^conhecerescola\.com\.br$ [NC]
RewriteRule ^conhecer-advanced-enfermagem/?$ https://tecnico.conhecerescola.com.br/curso-enfermagem.html [R=301,L]

RewriteCond %{HTTP_HOST} ^conhecerescola\.com\.br$ [NC]
RewriteCond %{DOCUMENT_ROOT}/tecnico/curso-$1.html -f
RewriteRule ^curso/([a-z0-9-]+)/?$ https://tecnico.conhecerescola.com.br/curso-$1.html [R=301,L]

RewriteCond %{HTTP_HOST} ^conhecerescola\.com\.br$ [NC]
RewriteRule ^curso/ https://tecnico.conhecerescola.com.br/cursos.html [R=301,L]

RewriteCond %{HTTP_HOST} ^conhecerescola\.com\.br$ [NC]
RewriteRule ^(home|voce-conhece-o-curso-de-tanatopraxia-entenda-aqui)/?$ https://conhecerescola.com.br/ [R=301,L]

# Arquivos do WordPress não existem mais: 410 avisa o Google para esquecê-los
RewriteRule ^wp-(content|includes|admin|json)(/|$) - [G,L]
RewriteRule ^(wp-login\.php|xmlrpc\.php)$ - [G,L]
</IfModule>

# Cache de arquivos estáticos
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
</IfModule>

# Cabeçalhos de segurança
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
Header always unset X-Powered-By
Header unset X-Powered-By
</IfModule>
